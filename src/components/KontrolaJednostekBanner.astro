---
// Czarny baner „Kontrola jednostek organizacyjnych" (zastąpił dawny baner „Wymagania NIS2").
// Jedno źródło treści dla strony głównej i /komu-pomagamy; prowadzi na /kontrola-jednostek.
import { Image } from 'astro:assets'
import ArrowButton from './ArrowButton.astro'
import nis2Img from '../assets/img/wymagania-nis2x2.jpg'

const punkty = [
  'lista jednostek i ich wskaźnik bezpieczeństwa',
  'wymagany poziom dla każdej kategorii jednostek',
  'przypomnienia i raport jednym kliknięciem',
]
---

<section class="bg-black text-white py-16 lg:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
      <div class="lg:w-1/2">
        <Image src={nis2Img} alt="Pracownicy przy komputerach" width={627} class="w-full rounded-xl" loading="lazy" />
      </div>
      <div class="lg:w-1/2">
        <p class="font-medium uppercase text-sm tracking-wide mb-4">
          <span class="inline-flex items-center gap-1.5 bg-brand-tag-yellow border border-brand-tag-yellow px-4 py-1 rounded-full text-black">
            <img src="/img/mini-sygnet.svg" alt="" width="19" height="20" class="w-[19px]" />
            Samorząd
          </span>
        </p>
        <h2 class="text-2xl lg:text-section-title font-semibold leading-tight mb-6">Kontrola jednostek organizacyjnych</h2>
        <p class="text-xl lg:text-2xl font-medium leading-snug text-white/80 mb-6">
          Urząd widzi stan cyberbezpieczeństwa wszystkich jednostek na jednym ekranie.
        </p>
        <ul class="space-y-2 text-lg text-white/80 mb-8">
          {punkty.map((p) => (
            <li class="flex items-start gap-2.5">
              <span class="flex h-7 shrink-0 items-center"><span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span></span>{p}
            </li>
          ))}
        </ul>
        <ArrowButton variant="yellow" label="Zobacz, jak to działa" href="/kontrola-jednostek" />
      </div>
    </div>
  </div>
</section>
