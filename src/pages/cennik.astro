---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PricingCards } from '../components/pricing/PricingCards';

// On-demand render, żeby access gate w `src/middleware.ts` mógł chronić tę trasę.
export const prerender = false;
---

<BaseLayout
  title="Cennik &mdash; CyberCover"
  description="Wybierz plan ochrony dostosowany do potrzeb Twojej organizacji: Standard, Optimum, Profesjonalny lub Ekspert."
>
  {/* Tło strony musi być ciemniejsze od kart (v6: --tlo-strony #F8F7F4 vs --tlo-karty #FFFFFF) —
      bez tego białe karty leżą na białym `body` i znika przejście spod czarnego pasa. */}
  <main class="relative min-h-screen bg-brand-bg pb-20">
    <div class="cc-band" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1360px] px-4 pt-32 lg:pt-40">
      <div class="cc-hero mb-10 flex flex-wrap items-end justify-between gap-5">
        <div class="flex flex-col gap-3.5">
          <h1 class="max-w-[20ch] text-[34px] font-bold leading-[1.1] tracking-[-0.03em] text-white md:text-[52px] xl:text-[60px]">
            Cennik <span class="text-white/45">&mdash; wybierz plan ochrony dostosowany do potrzeb Twojej organizacji</span>
          </h1>
          <p class="m-0 max-w-[46ch] text-sm leading-5 text-white/55">
            Umowa roczna. Wybierz rodzaj płatności: co miesiąc lub z góry za rok. Wszystkie ceny netto.
          </p>
        </div>
        <div class="flex flex-col gap-1 pb-1.5">
          <span class="text-sm text-white/45">Potrzebujesz więcej?</span>
          <a href="/kontakt" class="w-fit border-b border-white/35 pb-0.5 text-[15px] font-semibold text-white hover:border-white">
            Porozmawiajmy o wycenie
          </a>
        </div>
      </div>

      {/* `relative` — na mobile czarne tło nagłówka (.cc-hero::before) wchodzi pod karty; karty muszą leżeć nad nim. */}
      <div class="relative">
        <PricingCards client:load />
      </div>
    </div>
  </main>
</BaseLayout>
